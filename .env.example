HUB_HOST=127.0.0.1
HUB_PORT=8791
HUB_DATA_DIR=data

# Upstream OpenAI-compatible provider (the service's own credentials go in the
# service environment; never in this file):
# HUB_UPSTREAM_BASE_URL=https://api.example.com/v1
# ALISA_AI_KEY=

# Telegram Bot API:
# HUB_BOT_TOKEN=123456:ABC...
# HUB_OWNER_ID=0

# Base URL of this gateway, without /v1. Use the public HTTPS URL in production.
# HUB_PUBLIC_URL=https://api.example.com

# Quotas and limits (defaults for new users):
# HUB_DEFAULT_DAILY_REQUESTS=300
# HUB_DEFAULT_DAILY_USD=2.0
# HUB_MAX_OUTPUT_TOKENS=4096
# HUB_MAX_CONTEXT_MESSAGES=40
# HUB_RESET_HOUR_UTC=3
